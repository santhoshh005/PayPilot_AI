{
  "name": "paypilot-backend",
  "version": "1.0.0",
  "description": "Backend API & AI Agent service for PayPilot AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate --schema=../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "test": "vitest run --pool=forks --testTimeout=30000 --fileParallelism=false",
    "test:watch": "vitest",
    "seed": "npx tsx ../prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "prisma": "^6.4.1",
    "razorpay": "^2.9.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  },
  "license": "MIT"
}
