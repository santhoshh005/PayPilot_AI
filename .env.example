# ==========================================
# PayPilot AI Environment Configuration Example
# Copy this file to .env or backend/.env and frontend/.env
# ==========================================

# Database (PostgreSQL / Supabase)
# Transaction pooler connection string (Port 6543) with pgbouncer for application runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/Session connection string (Port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# AI Service (Google Gemini API)
GEMINI_API_KEY="AIzaSy..."

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Server Configuration
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Frontend Vite Configuration (used in frontend/.env)
VITE_API_URL="http://localhost:3001/api"
VITE_RAZORPAY_KEY_ID="rzp_test_..."
